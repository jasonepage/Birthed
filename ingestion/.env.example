# Copy to ingestion/.env and fill in. Never commit ingestion/.env.
# See CLAUDE.md section 9 for where each key comes from.

# Supabase project: Birthed, us-west-1
SUPABASE_URL=https://lunqqhjwqrpbujwxwdzk.supabase.co

# Service role key. This pipeline only, NEVER in the iOS app target.
# Supabase dashboard, Project Settings, API Keys, service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic key for the content check.
ANTHROPIC_API_KEY=

# Optional. The model that runs the content check. Defaults to claude-haiku-4-5,
# which is the fast inexpensive one. The literal Claude 3 Haiku, if you want
# that exact model, is claude-3-haiku-20240307.
# VIBE_CHECK_MODEL=claude-haiku-4-5

# Optional. Point the source at a web address instead of the checked in file.
# When this is empty the pipeline reads ingestion/seed_events.json.
# INGEST_SOURCE_URL=
# INGEST_SOURCE_FILE=seed_events.json

# Optional tuning, defaults shown.
# REQUEST_TIMEOUT_SECONDS=30
# MAX_RETRIES=4
