{
  "name": "birthed-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static date pages for birthed.app, and the process that serves them.",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "site": "npm run build && node --env-file-if-exists=.env dist/src/build.js",
    "og": "npm run build && node --env-file-if-exists=.env dist/src/og.js",
    "og:ci": "npx --yes playwright install chromium && npm run og",
    "serve": "npm run build && node dist/src/serve.js",
    "covers": "npm run build && node --env-file-if-exists=.env dist/src/download-covers.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "playwright": "^1.48.0"
  }
}
