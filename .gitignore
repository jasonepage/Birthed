# macOS
.DS_Store

# Xcode
xcuserdata/
*.xcuserstate
build/
DerivedData/

# Secrets. See CLAUDE.md section 9. Never commit these.
Birthed/Config/Secrets.swift
worker/.env
.env

# Node
node_modules/
dist/

# Swift package manager, used only to run the domain tests
.build/
.swiftpm/
Package.resolved

# Scratch folder the desktop app writes into. The icon source of truth is
# design/app-icon, not a rendered copy dropped in here.
Claude outputs/

# Generated static site
web/out/

# Python, used by the cultural event ingestion pipeline
.venv/
__pycache__/
*.pyc

# The Supabase CLI keeps its own scratch here: which CLI version it last
# saw, and which project this checkout is linked to. Both are local machine
# state rather than anything about the project.
supabase/.temp/

# Written by web/test/serve.test.ts, which builds a small site in the repo
# root to serve it. It is rebuilt on every run and is never an input.
web/test-site/

# Working notes: handoff briefs for sessions, drafts and proposals. They stay
# on the machine that wrote them and out of the public repository.
notes/
