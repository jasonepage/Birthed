# Copy to worker/.env and fill in. Never commit worker/.env. See CLAUDE.md section 9.

# Supabase project: Birthed, us-west-1
SUPABASE_URL=https://lunqqhjwqrpbujwxwdzk.supabase.co

# Service role key. Worker only, NEVER in the iOS app target.
# Supabase dashboard, Project Settings, API Keys, service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Contact address sent in the User-Agent header, which the Wikidata query
# service asks for so they can reach you if a query misbehaves.
WIKIDATA_CONTACT=jason@birthed.app

# Import tuning. All optional, defaults shown.
# WIKIDATA_YEAR_FROM=1600
# WIKIDATA_YEAR_TO=2015
# WIKIDATA_MIN_SITELINKS=10
# IMPORT_MAX_PER_DAY=50
